# Copy to .env for local work, or to .env.prod on the server.
# Nothing here is read automatically: load it with `set -a; . ./.env; set +a`,
# or let docker compose do it via env_file.

# --- Telegram ---------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Crypto Pay billing -----------------------------------------------------
# Leave CRYPTOBOT_TOKEN empty to run with billing switched off: every chat then
# has full access, which is fine locally and wrong in production.
#
# Local:      @CryptoTestnetBot -> Crypto Pay -> Create App -> API Token
# Production: @CryptoBot        -> Crypto Pay -> Create App -> API Token
# They are separate apps with separate tokens; do not mix them up.
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=true

# Public origin this process is reachable on. Crypto Pay only delivers webhooks
# to a public HTTPS URL, so locally this is a tunnel (cloudflared, ngrok,
# localtunnel) pointing at POCKETTRADER_WEBHOOK_PORT.
# Paste <PUBLIC_BASE_URL>/api/billing/webhook into the Crypto Pay app's
# Webhooks setting; `python -m pockettrader config` prints the exact URL.
PUBLIC_BASE_URL=
POCKETTRADER_WEBHOOK_HOST=0.0.0.0
POCKETTRADER_WEBHOOK_PORT=8080
POCKETTRADER_WEBHOOK_PATH=/api/billing/webhook

# --- Market data ------------------------------------------------------------
POCKETTRADER_EXCHANGE=binance
POCKETTRADER_TIMEFRAME=5m
POCKETTRADER_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT

# --- Signal engine ----------------------------------------------------------
POCKETTRADER_MIN_CONFIDENCE=0.55
POCKETTRADER_MIN_VOTES=2
POCKETTRADER_EXPIRY_BARS=3

# --- Bot behaviour ----------------------------------------------------------
POCKETTRADER_SCAN_INTERVAL_SECONDS=300
POCKETTRADER_ALERT_COOLDOWN_SECONDS=1800
POCKETTRADER_RATE_LIMIT_PER_MINUTE=20
POCKETTRADER_FREE_TRIAL_DAYS=3
# Chat ids allowed to use /grant. Empty means nobody can.
POCKETTRADER_ADMIN_CHAT_IDS=
# Restrict the bot to these chat ids. Empty means anyone may talk to it.
POCKETTRADER_ALLOWED_CHAT_IDS=
POCKETTRADER_SUBSCRIBERS_PATH=data/subscribers.json
