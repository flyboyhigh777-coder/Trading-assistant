# Скопируйте в .env для локальной работы или в .env.prod на сервере.
# Ничего не читается само: `set -a; . ./.env; set +a` либо env_file в compose.

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Данные -----------------------------------------------------------------
UZINVEST_CATALOG_PATH=bonds.yaml
UZINVEST_SUBSCRIBERS_PATH=data/subscribers.json

# --- Ориентиры для сравнения ------------------------------------------------
# Обновляйте: ставка ЦБ РУз и инфляция меняются, а от них зависит вывод бота.
UZINVEST_DEFAULT_DEPOSIT_RATE=0.22
UZINVEST_DEFAULT_INFLATION=0.10

# --- Payme ------------------------------------------------------------------
# Касса заводится в кабинете Payme Business. Пока ключи пусты, оплата выключена
# и доступ открыт всем: локально это удобно, в продакшене недопустимо.
# В кабинете укажите endpoint: <PUBLIC_BASE_URL>/api/billing/payme
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_TEST_MODE=true
UZINVEST_PAYME_ACCOUNT_FIELD=order_id

# --- Click ------------------------------------------------------------------
# Подключение по схеме SHOP-API. В кабинете укажите два адреса:
#   Prepare  — <PUBLIC_BASE_URL>/api/billing/click/prepare
#   Complete — <PUBLIC_BASE_URL>/api/billing/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# --- Адрес снаружи ----------------------------------------------------------
# Payme и Click ходят только на публичный HTTPS. Локально — туннель
# (cloudflared/ngrok) на UZINVEST_WEBHOOK_PORT, в проде — ваш домен.
# `python -m uzinvest config` напечатает готовые адреса для кабинетов.
PUBLIC_BASE_URL=
UZINVEST_WEBHOOK_HOST=0.0.0.0
UZINVEST_WEBHOOK_PORT=8080
UZINVEST_WEBHOOK_PATH=/api/billing

# --- Поведение бота ---------------------------------------------------------
UZINVEST_RATE_LIMIT_PER_MINUTE=20
UZINVEST_FREE_TRIAL_DAYS=7
UZINVEST_COUPON_REMINDER_DAYS=3
UZINVEST_REMINDER_HOUR_UTC=4          # 09:00 по Ташкенту (UTC+5)
UZINVEST_ADMIN_CHAT_IDS=
UZINVEST_ALLOWED_CHAT_IDS=
